# Neon Postgres — neon.tech → your project → Connection string (Postgres URL)
DATABASE_URL=postgresql://your-username:your-password@your-host.neon.tech/your-db?sslmode=require

# Moonshot API — platform.moonshot.cn → API keys
MOONSHOT_KEY=sk-your-real-key-here
MOONSHOT_BASE=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# Telegram bots — @BotFather → /newbot (create 3 bots, copy tokens)
# Format: token|brand_code|name   ;   separate with semicolons
BOT_CONFIG=123456789:ABCdefGHIjklMNOpqrSTUvwxyz|sevens|SevensBot;987654321:ZYXwvutsRQPonmlKJIHgfedCBA|kuro_kare|KuroKareBot;111222333:aaaBBBcccDDDeeeFFFggg|unassigned|TestBot

# Dashboard login password
DASHBOARD_PASSWORD=your-choice-here